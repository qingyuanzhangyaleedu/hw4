# Copy this file to .env; replace only the placeholder key locally.
PORTKEY_API_KEY=your-portkey-api-key-here
# Model used by the course project; your Portkey account must permit it.
MODEL_NAME=gpt-6-astra
# OpenAI-compatible Portkey endpoint; no credentials in this URL.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
